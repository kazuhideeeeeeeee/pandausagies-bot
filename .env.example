# Safe defaults: V2 never posts unless --send is explicitly supplied.
TIMEZONE=Asia/Tokyo
APP_ENV=development
STORAGE_PROVIDER=sqlite
X_PROVIDER=fake
X_APP_ID=
X_HANDLE=pandausagies
X_READ_ENABLED=false
X_WRITE_ENABLED=false
X_BEARER_TOKEN=
ALLOW_AUTONOMOUS_POSTS=false
ALLOW_AUTOMATED_REPLIES=false
AUTONOMOUS_ENABLED=false
ALLOW_EXTERNAL_SEND=false
KILL_SWITCH=true
FAKE_EXTERNALS=true
AUTONOMOUS_EPOCH=
PRODUCTION_MODE=false
OPENAI_MODEL_TEXT=gpt-4o-mini

# X OAuth 1.0a user-context credentials
API_KEY=
API_SECRET=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=

# Optional short rewrite helper
OPENAI_API_KEY=

# Optional future persistent storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Staging-only image candidate pipeline. Keep provider=fake in Phase A.
IMAGE_PROVIDER=fake
IMAGE_AUTOGEN_ENABLED=false
IMAGE_POST_RATIO=0.20
IMAGE_SKIP_RATIO=0.10
IMAGE_DAILY_LIMIT=2
IMAGE_MONTHLY_LIMIT=20
IMAGE_PROMPT_VERSION=v1
IMAGE_STORAGE_BUCKET=generated-media
IMAGE_REQUIRE_GLASSES_DEFAULT=true
IMAGE_BLUR_STYLE_DEFAULT=true
IMAGE_MAX_RETRIES=0
IMAGE_TIMEOUT_SECONDS=30
IMAGE_CIRCUIT_BREAKER_THRESHOLD=3
